// Windows resources for ImageAnalyzerTool.exe: the icon Explorer and the
// taskbar show, and the details under Properties > Details.
// Generated by CMake from src/app/ImageAnalyzerTool.rc.in.

#include <winver.h>

IDI_ICON1 ICON "@IAT_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@IAT_AUTHOR@"
            VALUE "FileDescription",  "Image Analyzer Tool"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "ImageAnalyzerTool"
            VALUE "LegalCopyright",   "Copyright (C) @IAT_YEAR@ @IAT_AUTHOR@"
            VALUE "OriginalFilename", "ImageAnalyzerTool.exe"
            VALUE "ProductName",      "Image Analyzer Tool"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
            VALUE "Comments",         "@PROJECT_HOMEPAGE_URL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
